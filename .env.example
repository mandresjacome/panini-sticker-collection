# Variables de entorno — App Láminas FIFA 2026
# Copia este archivo como .env y completa los valores reales.
# NUNCA commitear el archivo .env al repositorio.

# URL de tu proyecto Supabase (la encuentras en Settings > API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (anon/public key) — segura con RLS activo
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
